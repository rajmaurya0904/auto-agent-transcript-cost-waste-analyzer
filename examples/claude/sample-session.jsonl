{"type": "user", "sessionId": "demo-claude-session-anon-01", "timestamp": "2025-03-12T10:00:05.000Z", "isSidechain": false, "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_read_1", "content": "\"\"\"Login request handler for the demo web app.\"\"\"\n\ndef handle_login(request):\n    username = request.form.get(\"username\", \"\")\n    password = request.form.get(\"password\", \"\")\n    user = find_user(username)\n    if user is None or not check_password(user, password):\n        return error_response(\"invalid credentials\", status=401)\n    session = create_session(user)\n    return redirect(\"/dashboard\", session=session)\n\n\ndef find_user(username):\n    # Linear scan over an in-memory list -- fine for the demo dataset,\n    # but this is the first thing to profile on a real deployment.\n    for candidate in ALL_USERS:\n        if candidate.username == username:\n            return candidate\n    return None\n"}]}}
